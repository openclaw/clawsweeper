FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553

LABEL org.opencontainers.image.title="ClawSweeper automerge E2E base"
LABEL org.opencontainers.image.source="https://github.com/openclaw/clawsweeper"

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates gh git python3 \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
