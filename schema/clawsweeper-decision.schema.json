{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "closeReason",
    "confidence",
    "summary",
    "changeSummary",
    "changeExample",
    "systemContext",
    "architectureDiagram",
    "evidence",
    "likelyOwners",
    "risks",
    "bestSolution",
    "maintainerDecision",
    "triagePriority",
    "impactLabels",
    "mergeRiskLabels",
    "maturityLabels",
    "mergeRiskOptions",
    "reviewMetrics",
    "labelJustifications",
    "itemCategory",
    "reproductionStatus",
    "reproductionConfidence",
    "requiresNewFeature",
    "requiresNewConfigOption",
    "requiresProductDecision",
    "reproductionAssessment",
    "solutionAssessment",
    "visionFit",
    "visionFitReason",
    "visionFitEvidence",
    "implementationComplexity",
    "autoImplementationCandidate",
    "rootCauseCluster",
    "agentsPolicyStatus",
    "productReview",
    "provenance",
    "testingReview",
    "reviewFindings",
    "securityReview",
    "realBehaviorProof",
    "prRating",
    "telegramVisibleProof",
    "featureShowcase",
    "overallCorrectness",
    "overallConfidenceScore",
    "fixedRelease",
    "fixedSha",
    "fixedAt",
    "regressionAssessment",
    "regressionProvenance",
    "closeComment",
    "workCandidate",
    "workConfidence",
    "workPriority",
    "workReason",
    "nextStep",
    "workPrompt",
    "workClusterRefs",
    "workValidation",
    "workLikelyFiles"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["close", "keep_open"]
    },
    "closeReason": {
      "type": "string",
      "enum": [
        "implemented_on_main",
        "mostly_implemented_on_main",
        "cannot_reproduce",
        "clawhub",
        "duplicate_or_superseded",
        "low_signal_unmergeable_pr",
        "stalled_unproven_pr",
        "abandoned_pr",
        "unconfirmed_product_direction",
        "unsponsored_feature_request",
        "author_pr_budget_exceeded",
        "stale_version_bug",
        "obsolete_fix_pr",
        "not_actionable_in_repo",
        "incoherent",
        "stale_insufficient_info",
        "none"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "summary": {
      "type": "string"
    },
    "changeSummary": {
      "type": "string",
      "description": "One neutral plain sentence on what the PR changes or the issue requests, for a newcomer."
    },
    "changeExample": {
      "type": "object",
      "additionalProperties": false,
      "description": "One user-visible case with real values (scenario, before, after); empty when none.",
      "required": ["scenario", "before", "after"],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "systemContext": {
      "type": "string",
      "description": "Where the changed subsystem sits and what enters and leaves it."
    },
    "architectureDiagram": {
      "type": "string",
      "description": "Mermaid flowchart, no fences, 4-8 plain nodes, no click/URL/HTML/init/style directives."
    },
    "evidence": {
      "type": "array",
      "description": "Decision evidence, one repository per entry.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "label", "detail", "file", "line", "command", "sha"],
        "properties": {
          "repo": {
            "type": ["string", "null"],
            "description": "Verified owner/repo of this evidence; null when unknown."
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "file": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "command": {
            "type": ["string", "null"],
            "pattern": "^[^\\r\\n\\u2028\\u2029]*$",
            "description": "Exact read-only command on one line; null when multiline."
          },
          "sha": {
            "type": ["string", "null"],
            "description": "Full commit SHA in repo, never the target's on dependency evidence."
          }
        }
      }
    },
    "likelyOwners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["person", "role", "reason", "commits", "files", "confidence", "history"],
        "properties": {
          "person": {
            "type": "string",
            "description": "GitHub handle or name, never an email."
          },
          "role": {
            "type": "string",
            "description": "Neutral routing role (feature owner, area contributor, reviewer, merger); maintainer only with proof."
          },
          "reason": {
            "type": "string"
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "history": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["commitSha", "sourcePath", "sourceLine", "actor"],
            "description": "A line this person authored or committed at the review checkout; null for CODEOWNERS, context, or domain candidates.",
            "properties": {
              "commitSha": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "sourcePath": {
                "type": "string",
                "maxLength": 4096
              },
              "sourceLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "actor": {
                "type": "string",
                "enum": ["author", "committer"]
              }
            }
          }
        }
      }
    },
    "risks": {
      "description": "Unresolved concerns; for PRs each is a blocking Before-merge item.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bestSolution": {
      "type": "string",
      "description": "Best end state: for closes the best current outcome, else the best implementation, product, or docs path."
    },
    "maintainerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "kind", "question", "rationale", "options", "likelyOwner"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Only for an unresolved choice between viable options that evidence cannot settle and no maintainer decided."
        },
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "product_direction",
            "security_boundary",
            "proof_sufficiency",
            "release_inclusion",
            "merge_risk",
            "manual_review"
          ]
        },
        "question": {
          "type": "string",
          "description": "Exact item-specific question."
        },
        "rationale": {
          "type": "string",
          "description": "Why evidence and recorded decisions cannot settle it."
        },
        "options": {
          "type": "array",
          "maxItems": 3,
          "description": "Two or three viable choices, exactly one recommended.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body", "recommended"],
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "recommended": {
                "type": "boolean"
              }
            }
          }
        },
        "likelyOwner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["person", "reason", "confidence"],
          "properties": {
            "person": {
              "type": "string",
              "description": "Owner from likelyOwners."
            },
            "reason": {
              "type": "string"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          }
        }
      },
      "description": "All other fields are empty, none, or [] unless required."
    },
    "triagePriority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "none"],
      "description": "P0: Emergency: data loss, security bypass, crash loop, or unusable core runtime. P1: Urgent regression or broken agent/channel workflow affecting real users now. P2: Normal priority bug or improvement with limited blast radius. P3: Low-risk cleanup, docs, polish, ergonomics, or speculative feature. none: no priority label."
    },
    "impactLabels": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "impact:data-loss",
          "impact:security",
          "impact:crash-loop",
          "impact:message-loss",
          "impact:session-state",
          "impact:auth-provider",
          "impact:ux-release-blocker",
          "impact:ux-friction",
          "impact:other"
        ]
      },
      "description": "Issue-only, at most 3. impact:data-loss: This issue is about lost, corrupted, or silently dropped user/session/config data. impact:security: This issue is about security boundaries, credentials, authz, sandboxing, or sensitive data. impact:crash-loop: This issue is about crashes, hangs, restart loops, or process-level availability. impact:message-loss: This issue is about lost, duplicated, misrouted, or suppressed channel messages. impact:session-state: This issue is about session, memory, transcript, context, or agent state drift. impact:auth-provider: This issue is about auth, provider routing, model choice, or SecretRef resolution. impact:ux-release-blocker: A non-technical user is blocked without terminal, logs, config, or support. impact:ux-friction: User-facing flow adds avoidable confusion or support burden without fully blocking progress. impact:other: This issue has meaningful maintainer-visible impact outside the owned taxonomy."
    },
    "mergeRiskLabels": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "merge-risk: 🚨 compatibility",
          "merge-risk: 🚨 message-delivery",
          "merge-risk: 🚨 session-state",
          "merge-risk: 🚨 auth-provider",
          "merge-risk: 🚨 security-boundary",
          "merge-risk: 🚨 availability",
          "merge-risk: 🚨 automation",
          "merge-risk: 🚨 other"
        ]
      },
      "description": "PR-only merge risks green CI does not settle, at most 3. merge-risk: 🚨 compatibility: 🚨 Merging this PR could break existing users, config, migrations, defaults, or upgrades. merge-risk: 🚨 message-delivery: 🚨 Merging this PR could drop, duplicate, misroute, suppress, or wrongly target messages. merge-risk: 🚨 session-state: 🚨 Merging this PR could lose, corrupt, stale, or mis-associate session or agent state. merge-risk: 🚨 auth-provider: 🚨 Merging this PR could break OAuth, tokens, provider routing, model choice, or credentials. merge-risk: 🚨 security-boundary: 🚨 Merging this PR could weaken sandboxing, authorization, credentials, or sensitive data. merge-risk: 🚨 availability: 🚨 Merging this PR could cause crashes, hangs, restart loops, stalls, or process outages. merge-risk: 🚨 automation: 🚨 Merging this PR could break CI, automerge, proof capture, label sync, or automation. merge-risk: 🚨 other: 🚨 Merging this PR has meaningful risk outside the owned taxonomy."
    },
    "maturityLabels": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string",
        "enum": ["maturity:stable"]
      },
      "description": "Issue-only maturity:stable for broken contract-defined behavior on an M4/M5 primary-owner surface."
    },
    "mergeRiskOptions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body", "category", "recommended", "automergeInstruction"],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["fix_before_merge", "accept_risk", "pause_or_close"]
          },
          "recommended": {
            "type": "boolean",
            "description": "At most one, for a clear best path."
          },
          "automergeInstruction": {
            "type": "string",
            "description": "Automerge special-instructions payload, no @clawsweeper command; only for a recommended fix_before_merge."
          }
        }
      },
      "description": "Options for unresolved merge risk; [] without risks or merge-risk labels."
    },
    "reviewMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "reason"],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Quantified maintainer-relevant PR facts, e.g. production-vs-test LOC (production +12, tests +85) with whether growth is justified."
    },
    "labelJustifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "reason"],
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "impact:data-loss",
              "impact:security",
              "impact:crash-loop",
              "impact:message-loss",
              "impact:session-state",
              "impact:auth-provider",
              "impact:ux-release-blocker",
              "impact:ux-friction",
              "impact:other",
              "maturity:stable",
              "merge-risk: 🚨 compatibility",
              "merge-risk: 🚨 message-delivery",
              "merge-risk: 🚨 session-state",
              "merge-risk: 🚨 auth-provider",
              "merge-risk: 🚨 security-boundary",
              "merge-risk: 🚨 availability",
              "merge-risk: 🚨 automation",
              "merge-risk: 🚨 other"
            ]
          },
          "reason": {
            "type": "string",
            "description": "For an other label, name the real impact or risk."
          }
        }
      },
      "description": "One per selected triagePriority, impact, maturity, and merge-risk label."
    },
    "itemCategory": {
      "type": "string",
      "enum": [
        "bug",
        "regression",
        "feature",
        "skill",
        "docs",
        "cleanup",
        "support",
        "admin",
        "security",
        "unclear"
      ],
      "description": "bug: broken behavior with defined expectations; skill: optional skill bundles; new capabilities, options, or policies are not bugs."
    },
    "reproductionStatus": {
      "type": "string",
      "enum": ["reproduced", "source_reproducible", "not_reproduced", "unclear", "not_applicable"],
      "description": "reproduced: high-confidence current-main reproduction; source_reproducible: source shows the path without a failing run."
    },
    "reproductionConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "requiresNewFeature": {
      "type": "boolean"
    },
    "requiresNewConfigOption": {
      "type": "boolean",
      "description": "Adds a config option, flag, setting, env var, or knob."
    },
    "requiresProductDecision": {
      "type": "boolean"
    },
    "reproductionAssessment": {
      "type": "string",
      "description": "Public answer to: Do we have a high-confidence way to reproduce the issue? With the evidence."
    },
    "solutionAssessment": {
      "type": "string",
      "description": "Public answer to: Is this the best way to solve the issue? With rationale or a safer alternative."
    },
    "visionFit": {
      "type": "string",
      "enum": ["aligned", "rejected", "unclear", "not_applicable"],
      "description": "Issue fit with VISION.md; rejected when it places the work elsewhere or later."
    },
    "visionFitReason": {
      "type": "string"
    },
    "visionFitEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementationComplexity": {
      "type": "string",
      "enum": ["small", "medium", "large", "unclear", "not_applicable"],
      "description": "Issue-to-PR size; small is one focused PR with clear files and validation."
    },
    "autoImplementationCandidate": {
      "type": "string",
      "enum": ["none", "strict_bug", "vision_fit"]
    },
    "rootCauseCluster": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evidence-backed root-cause relationship, never from title, label, or gitcrawl similarity alone; members exclude this item.",
      "required": ["confidence", "canonicalRef", "currentItemRelationship", "summary", "members"],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "canonicalRef": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/(?:issues|pull)/[1-9][0-9]*$"
        },
        "currentItemRelationship": {
          "type": "string",
          "enum": [
            "canonical",
            "duplicate",
            "same_root_cause",
            "partial_overlap",
            "adjacent_distinct",
            "superseded",
            "fixed_by_candidate",
            "independent",
            "security_route",
            "needs_human"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "members": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "relationship", "reason"],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/(?:issues|pull)/[1-9][0-9]*$"
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "canonical",
                  "duplicate",
                  "same_root_cause",
                  "partial_overlap",
                  "adjacent_distinct",
                  "superseded",
                  "fixed_by_candidate",
                  "independent",
                  "security_route",
                  "needs_human"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "agentsPolicyStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["found", "readFully", "applied", "status", "summary"],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "readFully": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "found_applied",
            "found_not_applicable",
            "not_found",
            "conflict_not_applied",
            "unreadable_or_unclear"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "productReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "userProblem", "fixScope", "worthIt", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bug_fix",
            "preference",
            "feature",
            "refactor",
            "performance",
            "test_only",
            "docs",
            "maintenance",
            "not_applicable"
          ],
          "description": "bug_fix: differs from designed or documented behavior; preference: wants other behavior that works as designed."
        },
        "userProblem": {
          "type": "string",
          "description": "What the user sees; empty when none."
        },
        "fixScope": {
          "type": "string",
          "enum": ["complete", "partial", "not_applicable"],
          "description": "partial: delivers part of the linked issue's expected behavior, so the PR uses Related:, not Fixes/Closes."
        },
        "worthIt": {
          "type": "string",
          "enum": ["yes", "no", "needs_maintainer", "not_applicable"],
          "description": "yes: clear user value above cost; no: no clear problem, niche preference, or costly churn."
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "introducedBy", "originalReason", "verdict"],
        "properties": {
          "area": {
            "type": "string"
          },
          "introducedBy": {
            "type": "string",
            "description": "Commit SHA or PR URL; unknown when a real search finds none."
          },
          "originalReason": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": ["respects", "overrides_with_reason", "overrides_without_reason", "unknown"],
            "description": "overrides_with_reason: the PR explains the change of intent; unknown: a real search found no reason."
          }
        }
      }
    },
    "testingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofPath", "lowValueTests", "missingE2e"],
      "properties": {
        "proofPath": {
          "type": "string",
          "enum": [
            "shipped_entry_point",
            "in_process_harness",
            "unit_only",
            "none",
            "not_applicable"
          ],
          "description": "Strongest proof: shipped_entry_point; in_process_harness (real code, one process); unit_only; none (a PR test running the change is harness or unit)."
        },
        "lowValueTests": {
          "type": "array",
          "maxItems": 10,
          "description": "Added tests that mirror the code, assert mocks or call counts, duplicate coverage, pin incidental wording or defaults, or test a helper.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reason"],
            "properties": {
              "file": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "missingE2e": {
          "type": "string",
          "description": "Missing shipped-entry-point scenario; empty when none."
        }
      }
    },
    "reviewFindings": {
      "type": "array",
      "description": "Bugs the patch introduces; [] for issues, closes, or no discrete bug.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body",
          "priority",
          "confidenceScore",
          "file",
          "lineStart",
          "lineEnd",
          "lateFinding"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Imperative, at most 80 characters."
          },
          "body": {
            "type": "string",
            "description": "The concrete bug and why it breaks."
          },
          "priority": {
            "type": "integer",
            "enum": [0, 1, 2, 3],
            "description": "0=P0 critical, 1=P1 high, 2=P2 normal, 3=P3 low."
          },
          "confidenceScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "file": {
            "type": "string"
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1
          },
          "lateFinding": {
            "type": "boolean",
            "description": "Code unchanged since an earlier reviewed head where the concern was equally visible."
          }
        }
      }
    },
    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "cleared: no concrete concern.",
      "required": ["status", "summary", "concerns"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["cleared", "needs_attention", "not_applicable"]
        },
        "summary": {
          "type": "string"
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body", "severity", "confidenceScore", "file", "line"],
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "confidenceScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "file": {
                "type": ["string", "null"]
              },
              "line": {
                "type": ["integer", "null"],
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "realBehaviorProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidenceKind",
        "needsContributorAction",
        "dataModelCompatibility"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "sufficient",
            "missing",
            "mock_only",
            "insufficient",
            "not_applicable",
            "override"
          ],
          "description": "mock_only: only tests, mocks, or CI; insufficient: unrelated, unviewable, weak, or off-target; override: proof: override label; not_applicable: issues, maintainer/bot PRs outside the gate, docs-only PRs."
        },
        "summary": {
          "type": "string",
          "description": "Changed owner and behavior to exercised entry point, scenario, environment, and after-fix result or gap."
        },
        "evidenceKind": {
          "type": "string",
          "description": "Kind of the evidence proving the change, not of an unrelated smoke; screenshot only for directly visible UI.",
          "enum": [
            "screenshot",
            "recording",
            "terminal",
            "logs",
            "live_output",
            "linked_artifact",
            "none",
            "not_applicable"
          ]
        },
        "needsContributorAction": {
          "type": "boolean",
          "description": "False for sufficient, override, and not_applicable."
        },
        "dataModelCompatibility": {
          "type": "string",
          "enum": ["sufficient", "insufficient", "not_applicable"],
          "description": "Existing-state upgrade compatibility; sufficient includes a verified no-migration case."
        }
      }
    },
    "prRating": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tiers per the rating rubric; NA for non-PR items.",
      "required": ["proofTier", "patchTier", "overallTier", "summary", "nextSteps"],
      "properties": {
        "proofTier": {
          "type": "string",
          "enum": ["S", "A", "B", "C", "D", "F", "NA"],
          "description": "Proof quality only."
        },
        "patchTier": {
          "type": "string",
          "enum": ["S", "A", "B", "C", "D", "F", "NA"],
          "description": "Correctness, findings, security, scope, validation."
        },
        "overallTier": {
          "type": "string",
          "enum": ["S", "A", "B", "C", "D", "F", "NA"],
          "description": "Weaker of proofTier and patchTier, plus product judgement."
        },
        "summary": {
          "type": "string"
        },
        "nextSteps": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Zero to three rank-up moves."
        }
      }
    },
    "telegramVisibleProof": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether the PR changes Telegram-visible behavior to show with telegram-e2e-userbot.",
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["needed", "not_needed"]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "featureShowcase": {
      "type": "object",
      "additionalProperties": false,
      "description": "Positive-only spotlight, not a gate: showcase only an exceptional new user-facing feature idea without serious concerns.",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["showcase", "none"]
        },
        "reason": {
          "type": "string",
          "description": "Idea-level reason, never contributor worth."
        }
      }
    },
    "overallCorrectness": {
      "type": "string",
      "enum": ["patch is correct", "patch is incorrect", "not a patch"],
      "description": "patch is incorrect only when a listed P0-P2 finding blocks merge."
    },
    "overallConfidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fixedRelease": {
      "type": ["string", "null"],
      "description": "First release tag with the fix; null when main-only."
    },
    "fixedSha": {
      "type": ["string", "null"],
      "description": "Fixing commit; required for implemented_on_main and mostly_implemented_on_main."
    },
    "fixedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 time of fixedSha; required for those when fixedRelease is null."
    },
    "regressionAssessment": {
      "description": "suspected: one directly observed evidence kind; probable: two. Timing, history, title similarity, and correlation are no evidence.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["confidence", "supportingEvidence"],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": ["suspected", "probable"]
        },
        "supportingEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": ["reproduction", "reviewed_change", "failure_trace", "known_regression_link"]
          }
        }
      }
    },
    "regressionProvenance": {
      "description": "Earlier merged PR that introduced the exact responsible source line at the review revision; null unless known.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "repo",
        "pullRequestNumber",
        "pullRequestUrl",
        "mergeCommitSha",
        "sourcePath",
        "sourceLine"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "pullRequestNumber": {
          "type": "integer",
          "minimum": 1
        },
        "pullRequestUrl": {
          "type": "string"
        },
        "mergeCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "sourcePath": {
          "type": "string"
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "closeComment": {
      "type": "string",
      "description": "Close comment: opening sentence, blank line, evidence bullets (the reason, that this was a Codex review, credited discussion, paths, release, SHA, or fix time), and for thin evidence a reopen invitation naming what is missing."
    },
    "workCandidate": {
      "type": "string",
      "enum": ["none", "manual_review", "queue_fix_pr"]
    },
    "workConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "workPriority": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "workReason": {
      "type": "string",
      "description": "Routing reason; for issues also next-action guidance."
    },
    "nextStep": {
      "description": "PR next-step intent, never authority to fix or merge: required names the concrete action, human-owned blockers included, whatever its wording; none when nothing more is required.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["none"]
            },
            "text": {
              "type": "string",
              "enum": [""]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["required"]
            },
            "text": {
              "type": "string",
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            }
          }
        }
      ]
    },
    "workPrompt": {
      "type": "string"
    },
    "workClusterRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workValidation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workLikelyFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
