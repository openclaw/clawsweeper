{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/portable-review-receipt.v1.schema.json",
  "title": "Portable review receipt v1",
  "description": "Prospective self-reported review facts. Schema validity is not execution trust, policy acceptance, or behavior proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "input", "execution", "result", "usage"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "revision"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "target_repository",
        "object_format",
        "comparison",
        "base",
        "head",
        "worktree",
        "stages",
        "source_manifest_sha256",
        "context_sha256",
        "policy_sha256",
        "instructions_sha256",
        "review_config_sha256",
        "coverage_notes"
      ],
      "properties": {
        "repository": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "target_repository": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "object_format": {
          "enum": ["sha1", "sha256"]
        },
        "comparison": {
          "enum": ["merge-base-range", "parent-commit", "local-stages"]
        },
        "base": {
          "$ref": "#/$defs/git_revision"
        },
        "head": {
          "$ref": "#/$defs/git_revision"
        },
        "worktree": {
          "enum": ["clean", "dirty", "unknown"]
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["committed", "index", "working-tree", "untracked"]
          }
        },
        "source_manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "instructions_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_config_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_notes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion",
        "harness",
        "harness_version",
        "model",
        "expected_passes",
        "completed_passes"
      ],
      "properties": {
        "completion": {
          "enum": ["complete", "incomplete", "unavailable"]
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "harness_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "expected_passes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_passes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "native_status", "report_sha256", "threshold", "findings"],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "native_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "report_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "threshold": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "filtered", "rejected"],
          "properties": {
            "accepted": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filtered": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rejected": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "usage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/usage"
        }
      ]
    }
  },
  "$defs": {
    "git_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_write_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "scope",
        "complete",
        "attempts",
        "reported_attempts",
        "unknown_attempts",
        "partial_attempts",
        "tokens"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "scope": {
          "enum": ["process-attempts", "native-record", "unknown"]
        },
        "complete": {
          "type": ["boolean", "null"]
        },
        "attempts": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reported_attempts": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_attempts": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partial_attempts": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tokens"
            }
          ]
        }
      }
    }
  }
}
