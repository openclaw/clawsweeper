---
import { int, pct } from '../lib/format';

interface Props {
  segments: { label: string; value: number; color: string }[];
  legend?: boolean;
}
const { segments, legend = true } = Astro.props;
const total = segments.reduce((sum, segment) => sum + segment.value, 0) || 1;
---
<div>
  <div class="flex h-2 w-full gap-[2px] overflow-hidden rounded-full">
    {segments.filter(segment => segment.value > 0).map(segment => (
      <span class="h-full first:rounded-l-full last:rounded-r-full" style={`width:${(segment.value / total) * 100}%;background:${segment.color}`} data-tip={`${segment.label}\n${int(segment.value)} · ${pct(segment.value / total)}`}></span>
    ))}
  </div>
  {legend && (
    <ul class="mt-3 grid gap-1.5">
      {segments.map(segment => (
        <li class="flex items-center justify-between text-[13px]">
          <span class="flex items-center gap-2 text-fg-muted"><span class="size-2 rounded-[3px]" style={`background:${segment.color}`}></span>{segment.label}</span>
          <span class="flex items-baseline gap-2"><span class="num font-medium">{int(segment.value)}</span><span class="num w-11 text-right text-[12px] text-fg-faint">{pct(segment.value / total)}</span></span>
        </li>
      ))}
    </ul>
  )}
</div>
