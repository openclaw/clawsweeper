---
import Icon from './Icon.astro';
import Ago from './Ago.astro';
import { label } from '../lib/format';
import { attentionPriorityOrdered, type Item } from '../lib/data';

interface Props {
  items: Item[];
  limit?: number;
  meta?: 'reason' | 'maintainer' | 'security' | 'age';
  showRepo?: boolean;
}
const { items, limit = 8, meta = 'age', showRepo = true } = Astro.props;
const rows = items.slice(0, limit);
const metaLabel = meta === 'reason' ? 'Reason' : meta === 'maintainer' ? 'Decision' : 'Security';
const metaText = (item: Item) =>
  meta === 'reason' ? label(item.closeReason) : meta === 'maintainer' ? label(item.maintainerKind ?? '') : meta === 'security' ? label(item.security) : null;
---
{rows.length ? (
  <div class="item-list">
    <table class="table item-table" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Item</th>
          {meta !== 'age' && <th scope="col" role="columnheader">{metaLabel}</th>}
          <th scope="col" class="r" role="columnheader">Last review</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map(item => (
          <tr role="row">
            <td class="item-primary" role="cell">
              <a href={item.url} target="_blank" rel="noreferrer" class="group item-link">
                <span class="item-identity">
                  <span class="tag">{label(item.kind)}</span>
                  {attentionPriorityOrdered && (meta === 'maintainer' || meta === 'security') && <span class="tag" data-tip="Priority assigned by the reviewer; not independently verified.">{item.triagePriority ?? 'Unranked'}</span>}
                  <span class="num text-fg-muted">{showRepo ? `${item.repo.split('/')[1]}#${item.number}` : `#${item.number}`}</span>
                </span>
                <span class="item-title group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4">{item.title}</span>
                <Icon name="external" size={12} class="item-external text-fg-faint" />
              </a>
            </td>
            {meta !== 'age' && <td class="item-assessment text-fg-muted" role="cell"><span class="item-meta-label">{metaLabel}: </span>{metaText(item)}</td>}
            <td class="item-review num text-fg-muted" role="cell"><span class="item-meta-label">Last review: </span>{item.reviewedAt ? <Ago at={item.reviewedAt} /> : 'Unknown'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
) : (
  <p class="px-4 pb-4 text-[13px] text-fg-muted">Nothing here.</p>
)}
