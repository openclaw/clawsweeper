---
import Layout from '../components/Layout.astro';
import Kpi from '../components/Kpi.astro';
import Card from '../components/Card.astro';
import SegmentBar from '../components/SegmentBar.astro';
import ItemTable from '../components/ItemTable.astro';
import { asOf, cover, lists, repos, totals } from '../lib/data';
import { int, pct, stamp } from '../lib/format';

const openRepos = repos.filter(repo => repo.open > 0).sort((a, b) => b.staleOpen - a.staleOpen || b.open - a.open);
const staleOpen = repos.reduce((total, repo) => total + repo.staleOpen, 0);
---
<Layout title="Coverage" section="coverage">
  <h1 class="text-[22px] font-semibold tracking-tight">Coverage</h1>
  <p class="mt-1 text-[13px] text-fg-muted">Whether every open item has a fresh review.</p>

  <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
    <Kpi label="Coverage" value={`${cover.percent.toFixed(1)}%`} sub={`${int(cover.reviewed)} of ${int(cover.reviewable)}`}
      tip={`Reviewable open items with a review in the last ${cover.windowDays} days.\nSnapshot ${stamp(asOf.coverage)}`} />
    <Kpi label="Pending review" value={int(cover.pending)} tip="Reviewable items scheduled but not yet reviewed in the window." />
    <Kpi label="Stale" value={int(cover.stale)} tip={`Reviewable items whose latest review is older than ${cover.windowDays} days.`} />
    <Kpi label="Open, not reviewed in 7d" value={int(staleOpen)} sub={`${pct(staleOpen / Math.max(totals.open, 1))} of ${int(totals.open)} open`}
      tip="Open items in the stored corpus last reviewed more than seven days ago." />
  </div>

  <Card title="Reviewable backlog" class="mt-3" tip={`Coverage snapshot ${stamp(asOf.coverage)}`}>
    <SegmentBar segments={[
      { label: 'Reviewed recently', value: cover.reviewed, color: 'var(--ok)' },
      { label: 'Pending review', value: cover.pending, color: 'var(--accent)' },
      { label: 'Stale', value: cover.stale, color: 'var(--warn)' },
      { label: 'Never reviewed', value: cover.unreviewed, color: 'var(--bad)' },
    ]} />
  </Card>

  <div class="mt-3 grid gap-3 xl:grid-cols-5">
    <Card title="Repositories with open items" flush class="xl:col-span-3" tip="Sorted by stale open items. Stale means last reviewed over seven days ago.">
      <div class="max-h-[640px] overflow-auto">
        <table class="table">
          <thead class="sticky top-0 z-10 bg-bg"><tr><th>Repository</th><th class="r">Open</th><th class="r">Stale</th><th>Fresh</th><th class="r">7d</th><th class="r">30d</th></tr></thead>
          <tbody>
            {openRepos.map(repo => {
              const fresh = (repo.open - repo.staleOpen) / repo.open;
              return (
                <tr>
                  <td><a href={`/repos/${repo.slug}`} class="font-medium hover:underline">{repo.repo}</a></td>
                  <td class="r num">{int(repo.open)}</td>
                  <td class:list={['r num', repo.staleOpen > 0 ? 'text-warn' : 'text-fg-faint']}>{int(repo.staleOpen)}</td>
                  <td class="w-40">
                    <div class="flex items-center gap-2">
                      <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-bg-muted"><div class:list={['h-full rounded-full', fresh >= 0.9 ? 'bg-ok' : fresh >= 0.6 ? 'bg-warn' : 'bg-bad']} style={`width:${fresh * 100}%`}></div></div>
                      <span class="num w-10 text-right text-[12px] text-fg-muted">{pct(fresh, 0)}</span>
                    </div>
                  </td>
                  <td class="r num text-fg-muted">{int(repo.reviewed7d)}</td>
                  <td class="r num text-fg-muted">{int(repo.reviewed30d)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </Card>
    <Card title="Stalest open items" flush class="xl:col-span-2" tip="Open items with the oldest latest review.">
      <ItemTable items={lists.stale} meta="age" limit={16} />
    </Card>
  </div>
</Layout>
