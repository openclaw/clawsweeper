---
import Layout from '../components/Layout.astro';
import Kpi from '../components/Kpi.astro';
import Card from '../components/Card.astro';
import SegmentBar from '../components/SegmentBar.astro';
import { liveCover as cover, coverageRepositoryStates, repos } from '../lib/data';
import { int, stamp } from '../lib/format';
const count = (n: number | null | undefined) => n == null ? 'Unknown' : int(n);
const observed = (date: string | null) => date && Number.isFinite(Date.parse(date)) ? stamp(date) : "Unknown";
const percent = (n: number | null, known = false) => n === null ? (known ? 'N/A' : 'Unknown') : n.toFixed(1) + '%';
const liveRepos = [...cover.rows].filter(repo => ["eligible", "observed"].includes(repo.observationScope)).sort((a,b) => (b.open_records ?? -1) - (a.open_records ?? -1));
const liveNames = new Set(liveRepos.map(repo => repo.repo.toLowerCase()));
const outsideRepos = cover.rows.filter(repo => !["eligible", "observed"].includes(repo.observationScope));
const scopeText = (scope: string) => scope === "eligible" ? "Eligible policy candidate (not installation proof)" : scope === "observed" ? "Public observation; active eligibility unverified" : scope + " — outside review totals";
const segments = [
  { label: 'Fresh', value: cover.reviewed_recent ?? 0, color: 'var(--ok)', tip: 'Matching live identity and PR head, verified completion, valid review date within the window, and no later observed reopen.' },
  { label: 'Marked stale / changed', value: cover.stale ?? 0, color: 'var(--warn)', tip: 'Recorded stale_* status or changed live kind, PR head or a later observed reopen. Not the same as age expiry.' },
  { label: 'Expired', value: cover.expired ?? 0, color: 'var(--accent)', tip: 'Matching completed review outside the freshness window.' },
  { label: 'Failed', value: cover.failed ?? 0, color: 'var(--bad)', tip: 'Latest matching recorded attempt failed.' },
  { label: 'Missing usable evidence', value: (cover.unreviewed_records ?? 0) + (cover.untracked_open ?? 0), color: 'var(--fg-faint)', tip: 'No matching record, status, or usable review date. Earlier attempts may exist.' },
];
---
<Layout title="Coverage" section="coverage">
  <h1 class="text-[22px] font-semibold tracking-tight">Coverage</h1>
  <p class="mt-1 text-[13px] text-fg-muted">Observed GitHub Open counts and identity-matched review evidence are separate observations. Neither grants review admission nor proves GitHub App installation.</p>
  <p class="mt-2 text-[12px] text-fg-muted">Count observations: {observed(cover.countsAt)} – {observed(cover.countsThrough)} · Identity observation: {observed(cover.censusAt)} · Canonical record scan: {observed(cover.scanAt)} · Freshness window: {cover.windowDays} days. Counts are as of these observations, not a continuous GitHub query.</p>
  {!cover.known && <p class="mt-3 rounded border border-warn p-3 text-warn" role="status">Coverage unknown: {cover.reason}. Historical records cannot fill this gap.</p>}
  <p class="mt-2 text-[12px] text-fg-muted">Freshness checks recorded completion/date, PR head and the latest observed reopen only. Current issue body/comment semantic freshness is not proven by these fields; generic updated_at is not source validity.</p>
  <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
    <Kpi label="Observed Open" value={count(cover.open_records)} sub={count(cover.excluded) + ' excluded by live labels'} tip="Direct, timestamped GitHub repository totals. Remains known when identity pagination is bounded. Explicit archived/fork/alias/history scopes are outside this total; this is not an active-work or installation count." />
    <Kpi label="Fresh coverage" value={percent(cover.percent, cover.known)} sub={count(cover.reviewed_recent) + ' of ' + count(cover.reviewable_records) + ' reviewable'} tip="Matching-live completed evidence only. Missing, invalid and future dates are not fresh." />
    <Kpi label="Marked stale / changed" value={count(cover.stale)} tip="Explicit stale review state, changed PR head/kind, or a later observed reopen. Generic automation update timestamps are not source drift. Not age expiry and not an instruction to schedule another review." />
    <Kpi label="Expired reviews" value={count(cover.expired)} tip={'Completed matching-live reviews older than ' + cover.windowDays + ' days. Distinct from stale_* statuses.'} />
  </div>
  <Card title="Live review evidence" class="mt-3" tip="All segments use the same reviewable live-open cohort; label-excluded live items are outside the denominator.">
    {cover.known ? <SegmentBar segments={segments} /> : <p class="text-fg-muted">Unknown — no partial denominator or historical fallback.</p>}
  </Card>
  <div class="mt-3 grid gap-3 xl:grid-cols-5">
    <Card title="Observed public repositories" flush class="xl:col-span-3" tip="Open is a direct count observation. Reviewable, exclusions and Fresh require complete identity/label evidence and current canonical facts. Observed eligibility is not active admission.">
      <div class="max-h-[640px] overflow-auto"><table class="table"><thead><tr><th>Repository</th><th class="r">Observed Open</th><th class="r">Marked stale</th><th class="r">Expired</th><th class="r">Fresh</th></tr></thead><tbody>
        {liveRepos.map(repo => <tr data-coverage-repo={repo.repo}><td><a href={'https://github.com/' + repo.repo} class="font-medium hover:underline">{repo.repo}</a><div class="text-[11px] text-fg-muted">{scopeText(repo.observationScope)} · Counts {observed(repo.countsAt)}</div>{repo.countQualification && <div class="text-[11px] text-warn">Identity reference drifted; Open is an as-of count only.</div>}{repo.missingFields.length > 0 && <div class="text-[11px] text-warn">Missing fields: {repo.missingFields.join(", ")}</div>}{!repo.known && <div class="text-[11px] text-warn">Unknown: {repo.reason}</div>}</td><td class="r num">{count(repo.open_records)}</td><td class="r num">{count(repo.stale)}</td><td class="r num">{count(repo.expired)}</td><td class="r num">{percent(repo.percent, repo.known)}</td></tr>)}
        {!liveRepos.length && <tr><td colspan="5" class="text-fg-muted">No current public identity census rows. Live coverage is unknown.</td></tr>}
      </tbody></table></div>
    </Card>
    <Card title="Live items needing evidence" flush class="xl:col-span-2" tip="Bounded sample from known census rows only, matching-live and non-excluded. Fleet totals remain unknown if a public row is incomplete. Unknown/missing dates sort first, then oldest review.">
      <table class="table"><thead><tr><th>Item</th><th>Evidence</th></tr></thead><tbody>
        {cover.refresh.map(item => <tr><td><a href={'https://github.com/' + item.repo + (item.kind === 'pull_request' ? '/pull/' : '/issues/') + item.number} class="hover:underline">{item.repo} #{item.number}</a><div class="text-[11px] text-fg-muted">{item.reviewed_at ? stamp(item.reviewed_at) : 'No usable review date'}</div></td><td>{item.category === 'stale' ? 'Marked stale / changed' : item.category === 'expired' ? 'Expired' : item.category === 'failed' ? 'Failed' : 'Missing usable evidence'}</td></tr>)}
        {!cover.refresh.length && <tr><td colspan="2" class="text-fg-muted">{cover.known ? 'No items in this bounded sample.' : 'Unknown — census evidence unavailable.'}</td></tr>}
      </tbody></table>
    </Card>
  </div>
  {outsideRepos.length > 0 && <Card title="Outside qualified review scope — count references only" flush class="mt-3">
    <p class="p-3 text-[12px] text-fg-muted">Archived, fork, alias and historical observations remain visible but do not enter the Open or review totals above. A count does not establish active eligibility.</p>
    <div class="max-h-[320px] overflow-auto"><table class="table"><thead><tr><th>Repository</th><th>Disposition</th><th class="r">Observed Open</th><th>Count observed</th></tr></thead><tbody>{outsideRepos.map(repo => <tr data-coverage-repo={repo.repo}><td>{repo.repo}</td><td>{scopeText(repo.observationScope)}</td><td class="r num">{count(repo.open_records)}</td><td>{observed(repo.countsAt)}</td></tr>)}</tbody></table></div>
  </Card>}
  <Card title="Stored review history — not current-open coverage" flush class="mt-3" tip="Corpus rows and refresh-window totals can include closed or archived work. Neither 7d nor 30d is a live-open denominator.">
    <p class="p-3 text-[12px] text-fg-muted">Public stored history is separate from the live census. Archived, fork, alias or absent rows do not establish schedulability. Private/inaccessible repository names are withheld by build-time visibility checks; absence is not zero live work.</p>
    <div class="max-h-[400px] overflow-auto"><table class="table"><thead><tr><th>Repository</th><th>Observation</th><th class="r">Stored items</th><th class="r">Reviewed 7d</th><th class="r">Reviewed 30d</th></tr></thead><tbody>
      {repos.map(repo => <tr><td><a href={'/repos/' + repo.slug} class="hover:underline">{repo.repo}</a></td><td class="text-fg-muted">{coverageRepositoryStates[repo.repo.toLowerCase()] ?? (liveNames.has(repo.repo.toLowerCase()) ? 'Count observation; history separate' : 'Historical only / absent from census; live state unknown')}</td><td class="r num">{int(repo.records)}</td><td class="r num">{int(repo.reviewed7d)}</td><td class="r num">{int(repo.reviewed30d)}</td></tr>)}
    </tbody></table></div>
  </Card>
</Layout>
