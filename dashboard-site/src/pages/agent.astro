---
import Layout from '../components/Layout.astro';
import Kpi from '../components/Kpi.astro';
import Card from '../components/Card.astro';
import TimeChart from '../components/TimeChart.astro';
import BarList from '../components/BarList.astro';
import Clear from '../components/Clear.astro';
import { asOf, entries, kpis, live, runs } from '../lib/data';
import { duration, int, stamp } from '../lib/format';

const failures = live.failures && live.failures.status !== 'unknown' ? live.failures : null;
const runaway = live.runaway && live.runaway.status !== 'unknown' ? live.runaway : null;
const failureStages = entries({ ...failures?.by_stage });
const targets: string[] = runaway?.sample_item_keys ?? [];
const timingDays = runs.timings;
const timingObserved = timingDays.filter(day => day.reviewP50 !== null || day.reviewP90 !== null).length;
---
<Layout title="Agent performance" section="agent">
  <h1 class="text-[22px] font-semibold tracking-tight">Agent performance</h1>
  <p class="mt-1 text-[13px] text-fg-muted">How long execution takes, where attempts fail, and which items repeat.</p>

  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    <Kpi label="Model time · p50" value={duration(kpis.reviewTime.p50)} sub={`p90 ${duration(kpis.reviewTime.p90)} · n=${int(kpis.reviewTime.count)}`}
      tip={`Model execution in each item's latest stored review. Excludes queue and publication wait. Corpus ${stamp(asOf.corpus)}.`} />
    <Kpi label={failures ? `Failed attempts · ${failures.window_minutes}m` : 'Failed attempts'} value={failures ? int(failures.attempts) : '–'}
      sub={failures ? `${int(failures.terminal_attempts)} terminal · ${int(failures.retryable_attempts)} retryable` : 'Telemetry unavailable'}
      tip="Counts failed attempts, not distinct reviews or a failure rate. One target may fail more than once. Terminal attempts will not retry on their own." />
    <Kpi label={runaway ? `Repeated claims · ${runaway.window_hours}h` : 'Repeated claims'} value={runaway ? int(runaway.runaway_items) : '–'}
      sub={runaway ? `items with >${runaway.threshold_reviews_per_day} claims` : 'Telemetry unavailable'}
      tip="Targets above the review-claim threshold. A claim may end before model execution; revisions and triggers are not attributed." />
  </div>

  <Card title="Review run time · 30d" class="mt-3" tip="Daily p50 and p90 wall-clock duration of exact review runs. Includes run setup and finalization, but not time waiting before the run. Older days can use sampled runs; gaps mean no timing observations.">
    <p class="mb-5 text-[13px] text-fg-muted">Lower is faster. If p90 rises while p50 stays flat, investigate the slower runs.</p>
    {timingObserved ? <TimeChart points={timingDays.map(day => ({ date: day.date, value: day.reviewP50 }))} unit="seconds" label="p50 · typical run" height={230}
      overlay={{ points: timingDays.map(day => ({ date: day.date, value: day.reviewP90 })), label: 'p90 · slower runs', noun: 'p90' }} />
      : <p class="text-[13px] text-fg-muted">No review-run timing samples in this window.</p>}
    <p class="mt-3 text-[11px] text-fg-muted">{timingObserved} of {timingDays.length} complete days with timings · Actions through {stamp(asOf.actions)}. Model-only time above uses a separate latest-review snapshot.</p>
  </Card>

  <div class="mt-3 grid gap-3 lg:grid-cols-2">
    <Card title="Where attempts fail" tip="Recorded failed review attempts by stage in the current rolling window. These counts do not include successful attempts.">
      {failureStages.length ? <BarList rows={failureStages} /> : failures ? <Clear text="No failed attempts in this window." /> : <p class="text-[13px] text-fg-muted">Failure telemetry unavailable.</p>}
      <p class="mt-4 text-[13px] text-fg-muted">Start with the largest stage, then check <a class="underline" href="/queue/">retry and backoff reasons</a>.</p>
      {failures && <p class="mt-2 text-[11px] text-fg-muted">{int(failures.affected_targets)} affected targets · last {failures.window_minutes} minutes · snapshot {stamp(asOf.queue)}</p>}
    </Card>
    <Card title="Repeatedly claimed items" tip="A bounded sample of public targets over the claim threshold, not a ranking of the most repeated items.">
      {targets.length ? <ul class="divide-y divide-line">{targets.map(key => {
        const [repo, number] = key.split('#');
        return <li class="py-2"><a class="break-all text-[13px] underline" href={`https://github.com/${repo}/issues/${number}`}>{key}</a></li>;
      })}</ul> : runaway?.runaway_items === 0 ? <Clear text="No items over the claim threshold." /> : <p class="text-[13px] text-fg-muted">{runaway ? 'No public sample targets in this snapshot.' : 'Claim telemetry unavailable.'}</p>}
      <p class="mt-4 text-[13px] text-fg-muted">Compare revisions and triggers on these items. Repeated claims alone do not prove wasted execution.</p>
      {runaway && <p class="mt-2 text-[11px] text-fg-muted">Showing {targets.length} of {int(runaway.runaway_items)} flagged items · snapshot {stamp(asOf.queue)}</p>}
    </Card>
  </div>

  <nav aria-label="Related metrics" class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-fg-muted">
    <a class="underline" href="/operations/">Flow, waiting and publication → Operations</a>
    <a class="underline" href="/throughput/">Review and close volume → Throughput</a>
    <a class="underline" href="/coverage/">Review freshness → Coverage</a>
  </nav>
</Layout>
