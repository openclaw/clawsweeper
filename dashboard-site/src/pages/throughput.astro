---
import Layout from '../components/Layout.astro';
import Kpi from '../components/Kpi.astro';
import Card from '../components/Card.astro';
import TabCard from '../components/TabCard.astro';
import TimeChart from '../components/TimeChart.astro';
import { kpis, runs, series } from '../lib/data';
import { duration, int, pct, short } from '../lib/format';

const last30 = runs.days.slice(-30);
const runs30 = last30.reduce((total, day) => total + day.total, 0);
const failed30 = last30.reduce((total, day) => total + day.failure, 0);
const perDay = (points: { value: number }[]) => points.reduce((total, point) => total + point.value, 0) / Math.max(points.length, 1);
---
<Layout title="Throughput" section="throughput">
  <h1 class="text-[22px] font-semibold tracking-tight">Throughput</h1>
  <p class="mt-1 text-[13px] text-fg-muted">How much ClawSweeper reviews and closes, and how its sweep runs behave.</p>

  <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
    <Kpi neutral label="Items refreshed · 30d" value={int(kpis.reviews30d.current)} delta={kpis.reviews30d.delta} sub={`${int(perDay(series.reviews(30)))} per day`}
      tip="Items whose latest stored review landed in the last 30 complete days. Delta compares with the prior 30 days." />
    <Kpi neutral label="Closes · 30d" value={int(kpis.closes30d.current)} delta={kpis.closes30d.delta} sub={`${int(perDay(series.closes(30)))} per day`}
      tip="Items ClawSweeper closed in the last 30 complete days. Delta compares with the prior 30 days. Merged PRs and items closed by others are not counted." />
    <Kpi label={`Sweep runs · ${last30.length}d`} value={short(runs30)} sub={`${int(failed30)} failed · ${pct(failed30 / Math.max(runs30, 1))}`}
      tip="All sweep workflow runs in the last complete days the dashboard has recorded (up to 30; history grows from the first build)." />
    <Kpi label="Model time · p50" value={duration(kpis.reviewTime.p50)} sub={`p90 ${duration(kpis.reviewTime.p90)} · n=${int(kpis.reviewTime.count)}`}
      tip="Model execution time in latest stored review records, across the corpus. Excludes queue and publication wait; not end-to-end latency." />
    <Kpi label="Creation → latest review" value={duration(kpis.latestReviewAge.p50)} sub={`p90 ${duration(kpis.latestReviewAge.p90)} · n=${int(kpis.latestReviewAge.count)}`}
      tip="Time from item creation to its latest stored review. Re-reviews reset it, so it overstates first-review latency for older items." />
  </div>

  <TabCard title="Latest-review dates" name="reviews" tabs={['30d', '90d', '140d', 'Maintainer share']} class="mt-3" tip="Each item counts once, on the day of its latest stored review. Re-reviewing an item moves its date; this is not immutable review-event history. The dashed line is the part authored by maintainers (owner, member or collaborator, or labelled maintainer). Maintainer share: that part as a percentage of each day's reviews, last 90 days.">
    <div class="panel"><TimeChart points={series.reviews(30)} noun="reviews" height={240} overlay={{ points: series.maintainerReviews(30), label: 'Maintainer-authored items', noun: 'maintainer-authored items' }} /></div>
    <div class="panel"><TimeChart points={series.reviews(90)} noun="reviews" height={240} overlay={{ points: series.maintainerReviews(90), label: 'Maintainer-authored items', noun: 'maintainer-authored items' }} /></div>
    <div class="panel"><TimeChart points={series.reviews(140)} noun="reviews" height={240} overlay={{ points: series.maintainerReviews(140), label: 'Maintainer-authored items', noun: 'maintainer-authored items' }} /></div>
    <div class="panel"><TimeChart points={series.maintainerShare(90)} kind="bar" unit="percent" noun="maintainer-authored items" color="var(--warn)" height={240} /></div>
  </TabCard>

  <div class="mt-3 grid gap-3 xl:grid-cols-2">
    <TabCard title="Closes per day" name="closes" tabs={['ClawSweeper · 30d', '90d', 'By others · 30d']} tip="ClawSweeper's own closes per day. By others: items ClawSweeper reviewed that were then merged, or closed by a maintainer or another bot.">
      <div class="panel"><TimeChart points={series.closes(30)} kind="bar" noun="closes" color="var(--close)" height={200} /></div>
      <div class="panel"><TimeChart points={series.closes(90)} kind="bar" noun="closes" color="var(--close)" height={200} /></div>
      <div class="panel"><TimeChart points={series.closedElsewhere(30)} kind="bar" noun="merged or closed by others" color="var(--ok)" height={200} /></div>
    </TabCard>
    <Card title="Sweep runs per day" tip="All sweep workflow runs, any outcome.">
      <TimeChart points={last30.map(day => ({ date: day.date, value: day.total }))} kind="bar" noun="runs" height={200} />
    </Card>
    <Card title="Sweep failure rate" tip="Failed + startup-failure runs ÷ all sweep runs, per day.">
      <TimeChart points={runs.failureRate.slice(-30)} kind="bar" unit="percent" noun="failed" color="var(--bad)" height={200} />
    </Card>
    <TabCard title="Review run duration" name="duration" tabs={['p50', 'p90']} tip="Wall-clock time of each exact review run (Review exact item), per day. Other sweep jobs are left out: they are short and move between workflow files. Days before the hourly history use a sample of about 300 reviews.">
      <div class="panel"><TimeChart points={last30.map(day => ({ date: day.date, value: day.reviewP50 }))} noun="seconds" height={200} /></div>
      <div class="panel"><TimeChart points={last30.map(day => ({ date: day.date, value: day.reviewP90 }))} noun="seconds" color="var(--warn)" height={200} /></div>
    </TabCard>
  </div>

  <Card title="Workflows" flush class="mt-3" tip="GitHub Actions archive, per workflow, over the days each one ran. For sweep, days before the hourly history add counts and a duration sample.">
    <div class="overflow-x-auto">
      <table class="table">
        <thead><tr><th>Workflow</th><th class="r">Runs</th><th class="r">Success</th><th class="r">Failed</th><th class="r">Cancelled</th><th class="r">p50</th><th class="r">p90</th><th class="r">Days</th></tr></thead>
        <tbody>
          {runs.workflows.map(workflow => (
            <tr>
              <td><div class="font-medium">{workflow.id}</div><div class="font-mono text-[11px] text-fg-faint">{workflow.file}</div></td>
              <td class="r num">{int(workflow.runs)}</td>
              <td class="r num"><span class:list={[workflow.success !== null && workflow.success < 0.9 ? 'text-bad' : workflow.success !== null && workflow.success < 0.97 ? 'text-warn' : '']}>{pct(workflow.success)}</span></td>
              <td class="r num">{int(workflow.failed)}</td>
              <td class="r num text-fg-muted">{int(workflow.cancelled)}</td>
              <td class="r num">{duration(workflow.p50)}</td>
              <td class="r num">{duration(workflow.p90)}</td>
              <td class="r num text-fg-muted">{workflow.days}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Card>
</Layout>
